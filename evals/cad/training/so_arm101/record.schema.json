{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution-verified native CAD reference trace (not model transcript)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "split", "lineage_group", "origin", "model", "task", "source", "trace", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "lineage_group": {"type": "string", "minLength": 1},
    "origin": {"const": "reference_program"},
    "model": {"type": "null"},
    "task": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["kind", "sha256", "license"],
      "properties": {"kind": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "license": {"type": "string"}}
    },
    "trace": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "arguments", "result"],
      "properties": {"action": {"type": "string"}, "arguments": {"type": "object"}, "result": {}}
    }},
    "verification": {
      "type": "object",
      "required": ["passed", "checks", "native_file", "native_sha256", "freecad_version", "scope"],
      "properties": {
        "passed": {"const": true},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "passed"], "properties": {"name": {"type": "string"}, "passed": {"const": true}}}},
        "native_file": {"type": "string"}, "native_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "freecad_version": {"type": "array"}, "scope": {"type": "string"}
      }
    }
  }
}
