{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wright synthetic native CAD edit fixtures",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "units", "cases"],
  "properties": {
    "schema_version": {"const": 1}, "units": {"const": "mm"},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "split", "family", "shell_radius", "plate_width", "bolt_count", "levels", "target_thickness"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "family": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "validation", "test"]},
        "shell_radius": {"type": "number", "exclusiveMinimum": 0},
        "plate_width": {"type": "number", "exclusiveMinimum": 0},
        "bolt_count": {"type": "integer", "enum": [4, 6]},
        "levels": {"type": "integer", "minimum": 2},
        "target_thickness": {"type": "number", "exclusiveMinimum": 0}
      }
    }}
  }
}
