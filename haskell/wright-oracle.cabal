cabal-version:      3.0
name:               wright-oracle
version:            0.1.0
synopsis:           Independent oracle for Wright's load-bearing formulas
license:            MIT
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Oracle.Atmosphere
                      Oracle.Nozzle
                      Oracle.Balloon
                      Oracle.Beam
                      Oracle.Radio
                      Oracle.Thermal
                      Oracle.Aero
                      Oracle.Json
                      Oracle.Cases
                      Oracle.Pcb
    hs-source-dirs:   src
    build-depends:    base >=4.17 && <5
    default-language: Haskell2010

executable wright-oracle
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4.17 && <5, wright-oracle
    default-language: Haskell2010

test-suite props
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Props.hs
    hs-source-dirs:   test
    build-depends:    base >=4.17 && <5, wright-oracle, QuickCheck >=2.14 && <2.17
    default-language: Haskell2010
