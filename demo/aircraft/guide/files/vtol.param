# ArduPilot QuadPlane parameters for quadplane_130mi, designed by Wright
# flight controller: corewing_f405_wing_v2
# check the board's UART map before the SERIALn lines
Q_ENABLE,1
Q_FRAME_CLASS,1  # Quad
Q_FRAME_TYPE,1  # X: Motor1 FR CCW, Motor2 RL CCW, Motor3 FL CW, Motor4 RR CW
Q_M_PWM_TYPE,6  # DShot600 to the 4-in-1 ESC
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,36
SERVO5_FUNCTION,70  # pusher throttle
SERVO6_FUNCTION,4  # left aileron
SERVO7_FUNCTION,4  # right aileron: set SERVO7_REVERSED after the surface check
SERVO8_FUNCTION,19  # elevator
SERVO9_FUNCTION,21  # left rudder
SERVO10_FUNCTION,21  # right rudder
AIRSPEED_MIN,18  # 1.25 x predicted stall
AIRSPEED_CRUISE,19.3  # best-range speed
TRIM_THROTTLE,69  # pusher duty at best range
SCALING_SPEED,19.3
TECS_SINK_MIN,2.1  # power-off sink at min-power speed
AIRSPEED_MAX,25  # 90 % of predicted top speed
Q_ASSIST_SPEED,15.4  # quad assist below 1.1 x stall
Q_M_THST_HOVER,0.357  # predicted; Q_M_HOVER_LEARN refines it
Q_M_HOVER_LEARN,2  # learn and save
Q_M_THST_EXPO,0  # fitted to the lift unit's thrust curve
Q_M_BAT_VOLT_MAX,25.2
Q_M_BAT_VOLT_MIN,18
Q_M_BAT_CURR_MAX,90  # pack and connector burst; hover T/W is computed under it
Q_TRANSITION_MS,5000
Q_RTL_MODE,1
RTL_AUTOLAND,0
ARSPD_TYPE,1  # MS4525 on I2C
ARSPD_USE,1
BATT_MONITOR,4  # the board's analog voltage and current sensor
BATT_CAPACITY,30000
BATT_ARM_VOLT,22.2
BATT_LOW_VOLT,19.8
BATT_CRT_VOLT,18.6
BATT_LOW_MAH,5455  # planned reserve plus two landing hovers
BATT_CRT_MAH,1978
BATT_FS_LOW_ACT,1  # RTL
BATT_FS_CRT_ACT,4  # QLand
RSSI_TYPE,3  # from the receiver protocol
FLTMODE_CH,5
FLTMODE1,18  # QHOVER QLOITER FBWA CRUISE AUTO QRTL
FLTMODE2,19  # QHOVER QLOITER FBWA CRUISE AUTO QRTL
FLTMODE3,5  # QHOVER QLOITER FBWA CRUISE AUTO QRTL
FLTMODE4,7  # QHOVER QLOITER FBWA CRUISE AUTO QRTL
FLTMODE5,10  # QHOVER QLOITER FBWA CRUISE AUTO QRTL
FLTMODE6,21  # QHOVER QLOITER FBWA CRUISE AUTO QRTL
ROLL_LIMIT_DEG,45
PTCH_LIM_MAX_DEG,20
PTCH_LIM_MIN_DEG,-25
STALL_PREVENTION,1
TKOFF_ALT,20
